{% extends "base.html" %}
<!-- 改成 login_content -->
{% block login_content %}<div class="login-box" style="background: white; padding: 40px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); width: 380px; text-align: left;">

    <h2 style="font-size: 22px; font-weight: 600; color: #1e293b; margin-bottom: 5px; border: none; padding: 0;" data-zh="Meiti 员工管理系统" data-en="Meiti Employee Management System">Meiti 员工管理系统</h2>
    <!-- ... 下面内容保持不变 ... -->
    <p style="font-size: 13px; color: #94a3b8; margin-bottom: 30px;" data-zh="所有角色统一登录入口" data-en="Unified entry page for all roles.">所有角色统一登录入口</p>

    {% if error %}
    <div data-zh-error="用户名或密码错误" data-en-error="Invalid username or password" style="background: #fef2f2; color: #ef4444; padding: 10px; border-radius: 6px; font-size: 13px; margin-bottom: 20px;">
        {{ error }}
    </div>
    {% endif %}

    <form method="POST">
        <div style="margin-bottom: 15px;">
            <label style="display: block; font-size: 13px; color: #475569; margin-bottom: 5px;" data-zh="用户名" data-en="Username">用户名</label>
            <input type="text" name="username" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; outline: none;" required>
        </div>
        <div style="margin-bottom: 25px;">
            <label style="display: block; font-size: 13px; color: #475569; margin-bottom: 5px;" data-zh="密码" data-en="Password">密码</label>
            <input type="password" name="password" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; outline: none;" required>
        </div>

        <button type="submit" style="background: #a84a2d; color: white; border: none; padding: 10px 24px; border-radius: 6px; font-size: 14px; cursor: pointer; font-weight: 500;" data-zh="登录" data-en="Login">登录</button>
    </form>

    <p style="font-size: 11px; color: #94a3b8; margin-top: 25px;" data-zh="登录失败会显示提示信息。" data-en="Text-based warning for failed login attempts.">登录失败会显示提示信息。</p></div>
{% endblock %}
